{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.js": {
      "includeFiles": "{data,public}/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index?__path=/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/indexnow",
      "schedule": "15 8 * * *"
    }
  ]
}
